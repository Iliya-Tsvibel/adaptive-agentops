{
  "version": 1,
  "provenance": "Hand-authored synthetic stimuli and oracle based on accepted Stage 5.1/5.2 contracts, separated from v5 regression data.",
  "repetitions": 2,
  "common_assertions": [
    "determinism",
    "immutability",
    "redaction",
    "output_allowlist",
    "output_bound",
    "no_io",
    "no_authority"
  ],
  "fixture_assertions": [
    "classification",
    "full_normalized_result",
    "source_provenance",
    "exact_diagnostic"
  ],
  "unchecked_assertions": [
    "exact_diagnostic",
    "no_custom_hooks"
  ],
  "cases": [
    {
      "id": "controller-effect-target-unavailable",
      "family": "corroboration",
      "nearest": "both-committed",
      "novelty": "A durable Controller result survives Target unavailability, attributed only to Controller.",
      "stimulus": {
        "kind": "fixture",
        "case": {
          "version": 1,
          "dispatch_id": "00000000-0000-4000-8000-000000000001",
          "controller": {
            "coverage": "COMPLETE",
            "capture": "fixture-1",
            "order": 1,
            "rows": [
              {
                "dispatch_id": "00000000-0000-4000-8000-000000000001",
                "action_id": "00000000-0000-4000-8000-000000000002",
                "digest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                "session_id": "00000000-0000-4000-8000-000000000004",
                "run_id": "00000000-0000-4000-8000-000000000005",
                "approval_id": "00000000-0000-4000-8000-000000000003",
                "outcome": "SIMULATED_EFFECT_COMMITTED",
                "event": {
                  "dispatch_id": "00000000-0000-4000-8000-000000000001",
                  "action_id": "00000000-0000-4000-8000-000000000002",
                  "session_id": "00000000-0000-4000-8000-000000000004",
                  "status": "SIMULATED_EFFECT_COMMITTED"
                },
                "effect_number": 1,
                "action": {
                  "action_id": "00000000-0000-4000-8000-000000000002",
                  "session_id": "00000000-0000-4000-8000-000000000004",
                  "run_id": "00000000-0000-4000-8000-000000000005"
                },
                "approval": {
                  "action_id": "00000000-0000-4000-8000-000000000002",
                  "session_id": "00000000-0000-4000-8000-000000000004",
                  "run_id": "00000000-0000-4000-8000-000000000005",
                  "approval_id": "00000000-0000-4000-8000-000000000003",
                  "consumed": true,
                  "decision": "APPROVED"
                }
              }
            ]
          },
          "target": {
            "coverage": "UNAVAILABLE",
            "capture": "fixture-2",
            "order": 2,
            "rows": []
          }
        }
      },
      "expected_result": {
        "status": "SIMULATED_EFFECT_RECORDED",
        "reason": "BOUND_EFFECT",
        "controller_coverage": "COMPLETE",
        "target_coverage": "UNAVAILABLE",
        "controller_capture": "fixture-1",
        "target_capture": "fixture-2",
        "controller_outcome": "SIMULATED_EFFECT_COMMITTED",
        "target_fact": "NOT_OBSERVED",
